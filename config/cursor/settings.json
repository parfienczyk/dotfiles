{
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "'Dank Mono', Menlo, Monaco, 'Courier New', monospace",
  "editor.formatOnSave": true,
  "files.autoSave": "afterDelay",
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "tabnine.experimentalAutoImports": true,
  "editor.tabSize": 2,
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "editor.fontLigatures": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "better-comments.highlightPlainText": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "git.autofetch": true,
  "editor.foldingImportsByDefault": true,
  "nxConsole.showNodeVersionOnStartup": false,
  "workbench.tree.enableStickyScroll": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "editor.stickyScroll.enabled": true,
  "editor.accessibilitySupport": "off",
  "window.zoomLevel": 3,
  "editor.fontSize": 14,
  "github.copilot.editor.enableAutoCompletions": true,
  "playwright.reuseBrowser": false,
  "playwright.showTrace": true,
  "projectManager.sortList": "Path",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "scm.providerCountBadge": "visible",
  "testing.countBadge": "passed",
  "diffEditor.ignoreTrimWhitespace": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.language.colorizedBracketPairs": [],
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "workbench.colorTheme": "Noctis Lux",
  "workbench.sideBar.location": "right",
  "sherlock.previewLanguageTag": "en",
  "json.schemaDownload.enable": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "claudeCode.preferredLocation": "panel",
  "window.autoDetectColorScheme": false,
  "cursor.general.glassShowWarningNotifications": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "cursor.composer.queueMessageDefaultBehavior": "steer",
  "claudeCode.hideOnboarding": true,
}
